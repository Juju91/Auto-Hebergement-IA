                     text_color=TEXT).pack(side="left", padx=20)

        self.btn_settings = ctk.CTkButton(header, text="⚙", width=34, height=28,
                                          fg_color="transparent", hover_color=INPUT_BG,
                                          text_color=TEXT, font=ctk.CTkFont(size=18),
                                          command=self.open_settings)
        self.btn_settings.pack(side="right", padx=(0, 14))
        self.btn_clear = ctk.CTkButton(header, text="Effacer", width=70, height=28,
                                       fg_color="transparent", border_width=1,
                                       border_color=MUTED, text_color=MUTED,
                                       hover_color=INPUT_BG, command=self.clear_chat)
