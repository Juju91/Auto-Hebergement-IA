except ImportError:
    STT_OK = False
try:
    import pyttsx3
    TTS_OK = True
except ImportError:
    TTS_OK = False

# ───────────────────────── PARAMÈTRES ─────────────────────────
SETTINGS_FILE = Path(__file__).with_name("settings.json")

DEFAULTS = {
    "mode": "auto",                      # auto | gemini | local
    "gemini_key": "",                    # ou variable d'environnement GEMINI_API_KEY
    "gemini_model": "gemini-2.5-flash",  # modifiable dans les paramètres
    "ollama_model": "gemma:2b",
    "system_prompt": "Tu es un assistant virtuel utile. Réponds en français, "
                     "de façon claire et concise.",
    "wake_words": "eureka, solara, jarvis, nimbus, celeste",
    "media_folder": r"C:/Users/xxxxxxxx/Music1Videos&Photos",
    "vosk_path": r"CHEMIN/vers/le/model/de/langage/vosk",
    "youtube_key": "",
}

MAX_HISTORY = 12  # nombre de messages gardés en mémoire pour le contexte
GEMINI_URL = "https://generativelanguage.googleapis.com/v1beta/models/{model}:{method}"

DATE_HEURE_KEYS = ["quelle heure", "l'heure", "quel jour", "date d'aujourd", "date d aujourd"]
INTERNET_KEYS = ["cherche", "sur youtube"]

# Palette
BG = "#0f1115"
PANEL = "#171a21"
INPUT_BG = "#1e222b"
HOVER = "#2a2f3b"
ACCENT = "#6c8cff"
ACCENT_HOVER = "#5273ee"
DANGER = "#e5484d"
DANGER_HOVER = "#c93a3f"
TEXT = "#e6e8ee"
MUTED = "#8a91a3"
USER_COLOR = "#9db4ff"
AI_COLOR = "#7ee0b0"

ctk.set_appearance_mode("dark")


def load_settings():
    cfg = dict(DEFAULTS)
    try:
        cfg.update(json.loads(SETTINGS_FILE.read_text(encoding="utf-8")))
    except (FileNotFoundError, ValueError):
        pass
    return cfg


def save_settings(cfg):
    SETTINGS_FILE.write_text(json.dumps(cfg, indent=2, ensure_ascii=False), encoding="utf-8")
    try:
        os.chmod(SETTINGS_FILE, 0o600)  # la clé API reste lisible par vous seul (Linux/macOS)
    except OSError:
        pass


def describe_error(e):
    if isinstance(e, (requests.ConnectionError, requests.Timeout)):
        return "pas de connexion internet"
    return str(e)[:160]


# ═════════════════════════ Fenêtre de paramètres ═════════════════════════
class SettingsWindow(ctk.CTkToplevel):
    MODES = {"Auto (Gemini si internet)": "auto", "Gemini uniquement": "gemini",
             "Local uniquement (Ollama)": "local"}

    def __init__(self, app):
        super().__init__(app)
        self.app = app
        self.title("Paramètres")
        self.geometry("580x700")
        self.configure(fg_color=BG)
        self.transient(app)
        self.entries = {}

        body = ctk.CTkScrollableFrame(self, fg_color=BG)
        body.pack(fill="both", expand=True, padx=12, pady=(12, 0))
        cfg = app.cfg

        self._section(body, "Intelligence artificielle")
        ctk.CTkLabel(body, text="Mode", text_color=MUTED, anchor="w").pack(fill="x", padx=8)
        self.mode_menu = ctk.CTkSegmentedButton(body, values=list(self.MODES),
                                                selected_color=ACCENT,
                                                selected_hover_color=ACCENT_HOVER,
                                                fg_color=INPUT_BG)
        inv = {v: k for k, v in self.MODES.items()}
        self.mode_menu.set(inv.get(cfg["mode"], "Auto (Gemini si internet)"))
        self.mode_menu.pack(fill="x", padx=8, pady=(2, 10))

        self._field(body, "Clé API Gemini", "gemini_key", show="•",
                    hint="Gratuite sur aistudio.google.com/apikey")
        self.show_var = ctk.BooleanVar(value=False)
        ctk.CTkCheckBox(body, text="Afficher la clé", variable=self.show_var,
                        command=self._toggle_key, text_color=MUTED,
                        fg_color=ACCENT).pack(anchor="w", padx=8, pady=(0, 8))
        self._field(body, "Modèle Gemini", "gemini_model",
                    hint="Ex : gemini-2.5-flash (rapide) ou gemini-2.5-pro (plus puissant)")
        self._field(body, "Modèle Ollama (local, secours)", "ollama_model")

        ctk.CTkLabel(body, text="Personnalité (prompt système)", text_color=MUTED,
                     anchor="w").pack(fill="x", padx=8, pady=(6, 0))
        self.prompt_box = ctk.CTkTextbox(body, height=90, fg_color=INPUT_BG, text_color=TEXT)
        self.prompt_box.pack(fill="x", padx=8, pady=(2, 8))
        self.prompt_box.insert("1.0", cfg["system_prompt"])

        self._section(body, "Voix & commandes")
        self._field(body, "Mots de réveil (séparés par des virgules)", "wake_words")
        self._field(body, "Dossier média (commande « lance »)", "media_folder")
        self._field(body, "Chemin du modèle Vosk (reconnaissance vocale)", "vosk_path")
        self._field(body, "Clé API YouTube (facultatif)", "youtube_key", show="•")

        bar = ctk.CTkFrame(self, fg_color=PANEL, corner_radius=0)
        bar.pack(fill="x")
        ctk.CTkButton(bar, text="Tester Gemini", fg_color=INPUT_BG, hover_color=HOVER,
                      command=self._test).pack(side="left", padx=12, pady=12)
        ctk.CTkButton(bar, text="Enregistrer", fg_color=ACCENT, hover_color=ACCENT_HOVER,
                      command=self._save).pack(side="right", padx=12, pady=12)
        ctk.CTkButton(bar, text="Annuler", fg_color="transparent", border_width=1,
                      border_color=MUTED, text_color=MUTED, hover_color=INPUT_BG,
                      command=self.destroy).pack(side="right", pady=12)

        self.after(150, self._grab)

    def _grab(self):
        try:
            self.lift()
            self.grab_set()
        except Exception:
            pass

    def _section(self, parent, title):
        ctk.CTkLabel(parent, text=title, font=ctk.CTkFont(size=15, weight="bold"),
                     text_color=ACCENT, anchor="w").pack(fill="x", padx=8, pady=(14, 6))

    def _field(self, parent, label, key, show=None, hint=None):
        ctk.CTkLabel(parent, text=label, text_color=MUTED, anchor="w").pack(fill="x", padx=8)
        e = ctk.CTkEntry(parent, fg_color=INPUT_BG, border_width=0, text_color=TEXT,
                         show=show or "", height=34)
        e.pack(fill="x", padx=8, pady=(2, 2 if hint else 8))
        e.insert(0, self.app.cfg.get(key, ""))
        self.entries[key] = e
        if hint:
            ctk.CTkLabel(parent, text=hint, text_color=MUTED, anchor="w",
                         font=ctk.CTkFont(size=11)).pack(fill="x", padx=8, pady=(0, 8))

    def _toggle_key(self):
        self.entries["gemini_key"].configure(show="" if self.show_var.get() else "•")

    def _collect(self):
        data = {k: e.get().strip() for k, e in self.entries.items()}
        data["mode"] = self.MODES[self.mode_menu.get()]
        data["system_prompt"] = self.prompt_box.get("1.0", "end").strip() \
            or DEFAULTS["system_prompt"]
        return data

    def _test(self):
        d = self._collect()
        self.app.test_gemini(d["gemini_key"] or os.environ.get("GEMINI_API_KEY", ""),
                             d["gemini_model"])

    def _save(self):
        self.app.cfg.update(self._collect())
        save_settings(self.app.cfg)
        self.app.post("sys", "Paramètres enregistrés.")
        self.app.post("status", "")
        self.destroy()


# ═════════════════════════ Application ═════════════════════════
class Assistant(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.cfg = load_settings()
        self.title("Assistant")
        self.geometry("900x700")
        self.minsize(620, 480)
        self.configure(fg_color=BG)

        self.ui_queue = queue.Queue()
        self.history = []
        self.generating = False
        self.stop_event = threading.Event()
        self.backend_label = None  # dernier moteur utilisé

        self.tts_queue = queue.Queue()
        self.tts_enabled = False
        self.tts_buffer = ""

        self.stt_active = False
        self.stt_stop = threading.Event()
        self.stt_thread = None

        self._build_ui()
        self._poll_queue()

        if TTS_OK:
            threading.Thread(target=self._tts_worker, daemon=True).start()

        self.post("sys", "Bonjour ! Écrivez un message ou activez le micro. "
                         f"Mots de réveil : {', '.join(self.wake_words())}.")
        if self.cfg["mode"] != "local" and not self.gemini_key():
            self.post("sys", "Astuce : ajoutez une clé API Gemini dans ⚙ Paramètres pour des "
                             "réponses plus rapides et plus intelligentes.")
        self.protocol("WM_DELETE_WINDOW", self._on_close)

    # ───────────────────────── Helpers config ─────────────────────────
    def gemini_key(self):
        return self.cfg["gemini_key"] or os.environ.get("GEMINI_API_KEY", "")

    def wake_words(self):
        return [w.strip().lower() for w in self.cfg["wake_words"].split(",") if w.strip()]

    def _idle_status(self):
        if self.backend_label:
            return f"● {self.backend_label}"
        mode = self.cfg["mode"]
        if mode == "local":
            return f"● {self.cfg['ollama_model']} (local)"
        if mode == "gemini":
            return f"● {self.cfg['gemini_model']}"
        return "● Auto" if self.gemini_key() else f"● {self.cfg['ollama_model']} (local)"

    # ───────────────────────── Interface ─────────────────────────
