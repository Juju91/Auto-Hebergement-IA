    def open_settings(self):
        if getattr(self, "_settings_win", None) and self._settings_win.winfo_exists():
            self._settings_win.focus()
            return
        self._settings_win = SettingsWindow(self)

    def _set_send_mode(self, generating):
        if generating:
            self.btn_send.configure(text="■ Stop", fg_color=DANGER, hover_color=DANGER_HOVER,
                                    command=self.stop_generation)
            self.status.configure(text="● réflexion…", text_color=ACCENT)
        else:
            self.btn_send.configure(text="Envoyer", fg_color=ACCENT, hover_color=ACCENT_HOVER,
                                    command=self.on_send)
            self.status.configure(text=self._idle_status(), text_color=MUTED)

    # ───────────────────── Affichage thread-safe ─────────────────────
    def post(self, kind, text=""):
        """Peut être appelé depuis n'importe quel thread."""
        self.ui_queue.put((kind, text))

    def _poll_queue(self):
        try:
            for _ in range(200):
                kind, text = self.ui_queue.get_nowait()
                self._handle_event(kind, text)
        except queue.Empty:
            pass
        self.after(25, self._poll_queue)

    def _append(self, text, tag):
        self.chat.configure(state="normal")
        self.chat._textbox.insert("end", text, tag)
        self.chat.configure(state="disabled")
        self.chat.see("end")

    def _handle_event(self, kind, text):
        if kind == "user":
            self._append("Vous\n", "user_name")
            self._append(text + "\n", "user_text")
        elif kind == "sys":
            self._append(text + "\n", "sys")
        elif kind == "ai_start":
            self._append(f"Assistant · {text}\n" if text else "Assistant\n", "ai_name")
        elif kind == "token":
            self._append(text, "ai_text")
        elif kind == "ai_end":
            self._append("\n", "ai_text")
        elif kind == "reply":
            self._append("Assistant\n", "ai_name")
            self._append(text + "\n", "ai_text")
            self.speak(text)
        elif kind == "busy":
            self.generating = (text == "1")
            self._set_send_mode(self.generating)
        elif kind == "status":
            if text:
                self.backend_label = text
            if not self.generating:
                self.status.configure(text=self._idle_status())
        elif kind == "stt_cmd":
            self.on_voice(text)
        elif kind == "stt_state":
            self._apply_stt_state(text == "1")

    # ───────────────────────── Envoi / commandes ─────────────────────────
    def on_send(self):
        text = self.entry.get().strip()
        if not text or self.generating:
            return
        self.entry.delete(0, "end")
        self.run_command(text)

    def on_voice(self, spoken):
        low = spoken.lower()
        for w in self.wake_words():
            if w in low:
                cmd = low.replace(w, "", 1).strip()
                if cmd and not self.generating:
                    self.run_command(cmd)
                return

    def run_command(self, text):
        self.post("user", text)
        self.post("busy", "1")
        self.stop_event.clear()
        threading.Thread(target=self._dispatch, args=(text,), daemon=True).start()

    def clear_chat(self):
        if self.generating:
            return
        self.history.clear()
        self.chat.configure(state="normal")
        self.chat.delete("1.0", "end")
        self.chat.configure(state="disabled")

    # ───────────────────────── Dispatch (thread) ─────────────────────────
    @staticmethod
    def _has(text, keys):
        return any(k in text for k in keys)

    def _dispatch(self, text):
        low = text.lower()
        try:
            if low == "/bye":
                self.after(0, self._on_close)
            elif self._has(low, INTERNET_KEYS):
                self._cmd_internet(low)
            elif self._has(low, DATE_HEURE_KEYS):
                self._cmd_date(low)
            elif re.search(r"\blance\b", low):
                self._cmd_launch(re.sub(r"\blance\b", "", low).strip())
            else:
                self._cmd_chat(text)
        except Exception as e:
            self.post("sys", f"Erreur : {e}")
        finally:
            self.post("busy", "0")

    def _cmd_date(self, low):
        now = datetime.now()
        if "heure" in low:
            self.post("reply", f"Il est {now.strftime('%H:%M:%S')}.")
        else:
            self.post("reply", f"On est le {now.strftime('%d-%m-%Y')}.")

    def _cmd_internet(self, low):
        if "youtube" in low:
            q = low.replace("sur youtube", "").replace("cherche", "").strip()
            self._youtube(q)
        else:
            q = low.replace("cherche", "").strip()
            webbrowser.open(f"https://www.google.com/search?q={quote_plus(q)}", new=2)
            self.post("reply", f"Recherche lancée : {q}")

    def _youtube(self, q):
        key = self.cfg["youtube_key"]
        if key:
            from googleapiclient.discovery import build
            yt = build("youtube", "v3", developerKey=key)
            res = yt.search().list(q=q, part="snippet", maxResults=1, type="video").execute()
            if res["items"]:
                url = f"https://www.youtube.com/watch?v={res['items'][0]['id']['videoId']}"
                webbrowser.open(url)
                self.post("reply", f"Vidéo lancée : {url}")
                return
            self.post("reply", "Aucune vidéo trouvée.")
        else:
            webbrowser.open(f"https://www.youtube.com/results?search_query={quote_plus(q)}")
            self.post("reply", f"Recherche YouTube : {q}")

    def _cmd_launch(self, query):
        folder = self.cfg["media_folder"]
        if not query:
            self.post("reply", "Aucune requête fournie.")
            return
        if not os.path.isdir(folder):
            self.post("reply", "Le dossier média n'existe pas (voir ⚙ Paramètres).")
            return
        words = query.split()
        found = [f for f in os.listdir(folder) if all(w in f.lower() for w in words)]
        if len(found) == 1:
            path = os.path.join(folder, found[0])
            if sys.platform.startswith("win"):
                os.startfile(path)
            elif sys.platform == "darwin":
                subprocess.Popen(["open", path])
            else:
                subprocess.Popen(["xdg-open", path])
            self.post("reply", f"{found[0]} ouvert.")
        elif found:
            self.post("reply", "Plusieurs fichiers trouvés :\n" + "\n".join(f"• {f}" for f in found))
        else:
            self.post("reply", "Aucun fichier trouvé avec ces mots-clés.")

    # ───────────────────────── Moteurs d'IA (streaming) ─────────────────────────
    def _stream_gemini(self, hist):
        """Générateur de morceaux de texte via l'API REST de Gemini (SSE)."""
        url = GEMINI_URL.format(model=self.cfg["gemini_model"],
                                method="streamGenerateContent") + "?alt=sse"
        body = {
            "systemInstruction": {"parts": [{"text": self.cfg["system_prompt"]}]},
            "contents": [{"role": "user" if m["role"] == "user" else "model",
                          "parts": [{"text": m["content"]}]} for m in hist],
        }
        resp = requests.post(url, json=body, stream=True, timeout=(5, 60),
                             headers={"x-goog-api-key": self.gemini_key(),
                                      "Content-Type": "application/json"})
        try:
            if resp.status_code != 200:
                msg = resp.text[:200]
                try:
                    msg = resp.json()["error"]["message"]
                except Exception:
                    pass
                raise RuntimeError(f"HTTP {resp.status_code} : {msg}")
            resp.encoding = "utf-8"
            for line in resp.iter_lines(decode_unicode=True):
                if not line or not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if payload == "[DONE]":
                    break
                data = json.loads(payload)
                for cand in data.get("candidates", []):
                    for part in cand.get("content", {}).get("parts", []):
                        if part.get("text"):
                            yield part["text"]
        finally:
            resp.close()

    def _stream_ollama(self, hist):
        messages = [{"role": "system", "content": self.cfg["system_prompt"]}] + hist
        stream = ollama.chat(model=self.cfg["ollama_model"], messages=messages, stream=True)
        try:
            for chunk in stream:
                yield chunk["message"]["content"]
        finally:
            close = getattr(stream, "close", None)
            if close:
                try:
                    close()
                except Exception:
                    pass

    def _consume(self, gen, label):
        """Affiche un flux token par token. Lève une exception si rien n'a pu démarrer
        (permet de basculer sur un autre moteur). Retourne le texte produit."""
        started = False
        answer = ""
        try:
            for token in gen:
                if self.stop_event.is_set():
                    break
                if not started:
                    self.post("ai_start", label)
                    started = True
                answer += token
                self.post("token", token)
                self._tts_feed(token)
            if started and self.stop_event.is_set():
                self.post("token", " […]")
        except Exception as e:
            if not started:
                raise
            self.post("token", f"\n[Flux interrompu : {describe_error(e)}]")
        finally:
            try:
                gen.close()
            except Exception:
                pass
            if started:
                self._tts_flush()
                self.post("ai_end")
        return answer

    def _cmd_chat(self, question):
        self.history.append({"role": "user", "content": question})
        hist = self.history[-MAX_HISTORY:]
        mode = self.cfg["mode"]
        answer = None

        if mode in ("auto", "gemini"):
            if self.gemini_key():
                try:
                    answer = self._consume(self._stream_gemini(hist),
                                           self.cfg["gemini_model"])
                    self.post("status", self.cfg["gemini_model"])
                except Exception as e:
                    why = describe_error(e)
                    if mode == "auto":
                        self.post("sys", f"Gemini indisponible ({why}) → bascule sur le "
                                         f"modèle local.")
                    else:
                        self.post("sys", f"Gemini indisponible ({why}).")
            elif mode == "gemini":
                self.post("sys", "Aucune clé API Gemini : ouvrez ⚙ Paramètres.")

        if answer is None and mode != "gemini":
            try:
                label = f"{self.cfg['ollama_model']} · local"
                answer = self._consume(self._stream_ollama(hist), label)
                self.post("status", f"{self.cfg['ollama_model']} (local)")
            except Exception as e:
                self.post("sys", f"Erreur Ollama : {describe_error(e)}. Ollama est-il lancé "
                                 f"et le modèle « {self.cfg['ollama_model']} » installé ?")

        if answer:
            self.history.append({"role": "assistant", "content": answer})
        else:
            self.history.pop()  # question sans réponse : on ne la garde pas dans le contexte
            if self.stop_event.is_set():
                self.post("sys", "Génération interrompue.")

    def stop_generation(self):
        if self.generating:
            self.stop_event.set()
            self._tts_clear()

    def test_gemini(self, key, model):
        def run():
            if not key:
                self.post("sys", "Test Gemini : aucune clé renseignée.")
                return
            try:
                r = requests.post(GEMINI_URL.format(model=model, method="generateContent"),
                                  headers={"x-goog-api-key": key},
                                  json={"contents": [{"parts": [{"text": "Réponds : OK"}]}]},
                                  timeout=(5, 20))
                if r.status_code == 200:
                    self.post("sys", f"✓ Gemini fonctionne ({model}).")
                else:
                    try:
                        msg = r.json()["error"]["message"]
                    except Exception:
                        msg = r.text[:150]
                    self.post("sys", f"✗ Test Gemini échoué : HTTP {r.status_code} – {msg}")
            except Exception as e:
                self.post("sys", f"✗ Test Gemini échoué : {describe_error(e)}")
        self.post("sys", "Test de la connexion Gemini…")
        threading.Thread(target=run, daemon=True).start()

    # ───────────────────────── TTS ─────────────────────────
    def toggle_tts(self):
        if not TTS_OK:
            self.post("sys", "pyttsx3 n'est pas installé.")
            return
        self.tts_enabled = not self.tts_enabled
        self.btn_tts.configure(text="🔊" if self.tts_enabled else "🔈",
                               fg_color=ACCENT if self.tts_enabled else INPUT_BG)
        if not self.tts_enabled:
            self._tts_clear()

    def speak(self, text):
        if self.tts_enabled and TTS_OK:
            self.tts_queue.put(text)

    def _tts_feed(self, token):
        """Lit la réponse phrase par phrase pendant le streaming."""
        if not (self.tts_enabled and TTS_OK):
            return
        self.tts_buffer += token
        m = re.search(r"(.+?[.!?\n])\s", self.tts_buffer, re.S)
        while m:
            self.tts_queue.put(m.group(1).strip())
            self.tts_buffer = self.tts_buffer[m.end():]
            m = re.search(r"(.+?[.!?\n])\s", self.tts_buffer, re.S)

    def _tts_flush(self):
        if self.tts_enabled and TTS_OK and self.tts_buffer.strip() \
                and not self.stop_event.is_set():
            self.tts_queue.put(self.tts_buffer.strip())
        self.tts_buffer = ""

    def _tts_clear(self):
        self.tts_buffer = ""
        try:
            while True:
                self.tts_queue.get_nowait()
        except queue.Empty:
            pass

    def _tts_worker(self):
        engine = pyttsx3.init()  # initialisé dans son propre thread
        while True:
            text = self.tts_queue.get()
            if text is None:
                break
            if self.tts_enabled:
                try:
                    engine.say(text)
                    engine.runAndWait()
                except Exception:
                    pass

    # ───────────────────────── STT ─────────────────────────
    def toggle_stt(self):
        if not STT_OK:
            self.post("sys", "pyaudio / vosk ne sont pas installés.")
            return
        if self.stt_active:
            self.stt_stop.set()
            self._apply_stt_state(False)
        else:
            self.stt_stop.clear()
            self.post("sys", "Chargement du modèle vocal…")
            self.stt_thread = threading.Thread(target=self._stt_loop, daemon=True)
            self.stt_thread.start()

    def _apply_stt_state(self, active):
        self.stt_active = active
        self.btn_mic.configure(fg_color=DANGER if active else INPUT_BG,
                               hover_color=DANGER_HOVER if active else HOVER)
        self.post("sys", "Micro activé." if active else "Micro désactivé.")

    def _stt_loop(self):
        try:
            rec = KaldiRecognizer(Model(self.cfg["vosk_path"]), 16000)
            pa = pyaudio.PyAudio()
            stream = pa.open(format=pyaudio.paInt16, channels=1, rate=16000,
                             input=True, frames_per_buffer=8000)
        except Exception as e:
            self.post("sys", f"Impossible de démarrer le micro : {e}")
            return
        self.post("stt_state", "1")
        try:
            while not self.stt_stop.is_set():
                data = stream.read(4000, exception_on_overflow=False)
                if rec.AcceptWaveform(data):
                    text = json.loads(rec.Result()).get("text", "").strip()
                    if text:
                        self.post("stt_cmd", text)
        finally:
            stream.stop_stream()
            stream.close()
            pa.terminate()

    # ───────────────────────── Fermeture ─────────────────────────
    def _on_close(self):
        self.stop_event.set()
        self.stt_stop.set()
        self.tts_queue.put(None)
        self.destroy()


if __name__ == "__main__":
    Assistant().mainloop()
